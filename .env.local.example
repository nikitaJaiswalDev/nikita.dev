# Resend (contact form email): https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Cloudflare Turnstile (contact form captcha): https://dash.cloudflare.com/?to=/:account/turnstile
# Site key is public (used in the browser); secret key is server-only.
# Without these, the captcha is skipped in local development but the form is rejected in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
